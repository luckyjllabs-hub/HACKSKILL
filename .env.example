# Gemini AI API Configuration (Server-Side Only)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Database Configuration (Firestore)
# Get these from Firebase Console -> Project Settings -> Web App Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase Admin Service Account Key (JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional: Supabase Config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
